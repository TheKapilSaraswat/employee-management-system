# Root env reference. Copy to .env and fill real values - never commit .env.

# --- Backend (used by docker compose and production) ---
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=604800000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Postgres
DB_NAME=employeemgmt
DB_USERNAME=employeemgmt
DB_PASSWORD=employeemgmt
DB_PORT=5434

# --- Frontend ---
# Leave unset locally to use the Vite dev proxy (http://localhost:5002/api).
VITE_API_URL=http://localhost:5002/api
