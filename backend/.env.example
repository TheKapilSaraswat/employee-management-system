# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5002

# Postgres connection. Prefer DATABASE_URL (Render/Neon/Railway format):
DATABASE_URL=
# ...or individual parts:
DB_URL=jdbc:postgresql://localhost:5432/employeemgmt
DB_USERNAME=employeemgmt
DB_PASSWORD=employeemgmt
DB_DDL_AUTO=update

# JWT
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=604800000

# First-run admin (created if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# CORS allowlist (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000

APP_BASE_URL=http://localhost:5002

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
